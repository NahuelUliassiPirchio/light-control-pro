{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "*.js",
    "app/**/*.ts",
    "app/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "forge.config.js",
    ".eslintrc.js"
  ]
}
